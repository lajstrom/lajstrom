<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Maven library of test/e2e/maven.sh: mvn deploy sends the jar, the sources jar, the javadoc
  jar and this pom, each with its .sha1 and .md5, then maven-metadata.xml. maven.sh deploys copies
  with the groupId and the version of the step written in. The build is reproducible
  (project.build.outputTimestamp, javadoc without timestamps), so that a deploy of the same
  version again sends the same bytes. No dependencies and no tests: the build stays short.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.e2e</groupId>
  <artifactId>lib</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Lajstrom e2e lib</name>
  <description>A library that the Lajstrom end-to-end scenario deploys with mvn deploy.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <notimestamp>true</notimestamp>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
