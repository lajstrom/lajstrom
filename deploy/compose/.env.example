# Settings of the dev stack (compose.yaml). Copy this file to deploy/compose/.env to change
# them; .env is not committed. Docker Compose reads it from this directory, and a variable set
# in the shell wins over the file. Every value below is the default.

# Host ports, published on 127.0.0.1. When you change one, change the URL or the DSN that
# points at it too: registries[].url in deploy/compose/lajstrom.yaml, LAJSTROM_TEST_REGISTRY,
# LAJSTROM_DATABASE_DSN.
LAJSTROM_ZOT_PORT=5000            # Zot, registry "local"; macOS AirPlay Receiver also wants 5000
LAJSTROM_DISTRIBUTION_PORT=5001   # distribution, registry "second"
LAJSTROM_PG_PORT=5432             # Postgres
LAJSTROM_DISTRIBUTION_S3_PORT=5002  # distribution on SeaweedFS, the s3 profile (make dev-up PROFILES=s3)
LAJSTROM_S3_PORT=9000             # the S3 gateway of SeaweedFS, the same port inside and outside: presigned URLs name it
LAJSTROM_DISTRIBUTION_S3_MINIO_PORT=5006  # distribution on MinIO, the fallback (make dev-up PROFILES=s3-minio)
LAJSTROM_MINIO_PORT=9001          # MinIO of the s3-minio profile, the same port inside and outside: presigned URLs name it
LAJSTROM_GITLAB_PORT=5003         # GitLab container registry, variant A, the gitlab profile (make dev-up PROFILES=gitlab)
LAJSTROM_GITLAB_DB_PORT=5004      # the same with its metadata database, variant B
LAJSTROM_HA_PORT=8090             # the edge of the ha profile, nginx (make dev-up PROFILES=ha); the replicas' externalURL follows it
LAJSTROM_HA_A_PORT=8091           # replica A of the ha profile, past the edge
LAJSTROM_HA_B_PORT=8092           # replica B of the ha profile, past the edge
LAJSTROM_HA_DISTRIBUTION_PORT=5007  # the distribution of the ha profile

# Variant B of the gitlab profile (docs/registries/gitlab.md): true lets the registry add unknown
# media types on push instead of refusing Lajstrom's manifests; -1 makes its online garbage
# collector review at once instead of 24h after an event.
LAJSTROM_GITLAB_DYNAMIC_MEDIA_TYPES=false
LAJSTROM_GITLAB_GC_REVIEWAFTER=24h

# Postgres database, user and password, applied when the volume is created: after a change,
# make dev-down RESET=1 && make dev-up.
LAJSTROM_PG_DB=lajstrom
LAJSTROM_PG_USER=lajstrom
LAJSTROM_PG_PASSWORD=lajstrom

# The master key that encrypts the apt signing keys (keys.masterKeyEnv of lajstrom.example.yaml):
# 64 hexadecimal characters, from openssl rand -hex 32. No container of the stack uses it, and
# make run does not read this file: export it in the shell that runs make run, and keep it for
# the next runs (docs/dev-stack.md). Unset, apt repos are unsigned; set but empty, serve stops.
LAJSTROM_MASTER_KEY=
