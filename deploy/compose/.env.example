# Settings of the dev stack (compose.yaml). Copy this file to deploy/compose/.env to change
# them; .env is not committed. Docker Compose reads it from this directory, and a variable set
# in the shell wins over the file. Every value below is the default.

# Host ports, published on 127.0.0.1. When you change one, change the URL or the DSN that
# points at it too: registries[].url in deploy/compose/lajstrom.yaml, LAJSTROM_TEST_REGISTRY,
# LAJSTROM_DATABASE_DSN.
LAJSTROM_ZOT_PORT=5000            # Zot, registry "local"; macOS AirPlay Receiver also wants 5000
LAJSTROM_DISTRIBUTION_PORT=5001   # distribution, registry "second"
LAJSTROM_PG_PORT=5432             # Postgres
LAJSTROM_DISTRIBUTION_S3_PORT=5002  # distribution on MinIO, the s3 profile (make dev-up PROFILES=s3)
LAJSTROM_MINIO_PORT=9000          # MinIO of the s3 profile, the same port inside and outside: presigned URLs name it

# Postgres database, user and password, applied when the volume is created: after a change,
# make dev-down RESET=1 && make dev-up.
LAJSTROM_PG_DB=lajstrom
LAJSTROM_PG_USER=lajstrom
LAJSTROM_PG_PASSWORD=lajstrom

# The master key that encrypts the apt signing keys (keys.masterKeyEnv of lajstrom.example.yaml):
# 64 hexadecimal characters, from openssl rand -hex 32. No container of the stack uses it, and
# make run does not read this file: export it in the shell that runs make run, and keep it for
# the next runs (docs/dev-stack.md). Unset, apt repos are unsigned; set but empty, serve stops.
LAJSTROM_MASTER_KEY=
